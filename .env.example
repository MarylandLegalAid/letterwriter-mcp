# Copy to .env for local development. The container takes these as environment
# variables instead; nothing reads a .env file in production.

# First line of every signature block. Set this — the default is a placeholder.
ORGANIZATION_NAME=Example Legal Aid

# Where your letterheads.json and .docx files live.
LETTERHEAD_DIR=/data/letterheads

MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3002

# The MCP SDK refuses requests whose Host header is not listed here. Behind
# Docker Compose the caller sends the service name, so list it.
MCP_ALLOWED_HOSTS=letterwriter-mcp,localhost,127.0.0.1

# Optional. No-ops when unset, which is the intended configuration on a private
# container network.
# MCP_SHARED_SECRET=
